{
  "version": "2.0.0",
  "tasks": [{
    "label": "VibeBuild32: Start VS Code debug adapter",
    "type": "process",
    "command": "node",
    "args": ["${workspaceFolder}/.vscode/vibebuild32-debug-adapter.js", "--port", "4714"],
    "isBackground": true,
    "problemMatcher": {
      "owner": "vibebuild32",
      "pattern": [{ "regexp": "^(.*)$", "message": 1 }],
      "background": { "activeOnStart": true, "beginsPattern": ".*", "endsPattern": "^VibeBuild32 DAP adapter listening on 4714$" }
    },
    "options": { "env": { "NODE_OPTIONS": "" } }
  }]
}
